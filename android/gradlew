#!/usr/bin/env sh
# Lightweight Gradle launcher for GitHub Actions.
# Downloads the pinned Gradle distribution because the original ZIP did not
# contain the binary Gradle Wrapper JAR.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION="8.10.2"
GRADLE_HOME_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/croisse-gradle/gradle-${GRADLE_VERSION}"
GRADLE_BIN="$GRADLE_HOME_DIR/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$(dirname "$GRADLE_HOME_DIR")"
  ZIP_FILE="${TMPDIR:-/tmp}/gradle-${GRADLE_VERSION}-all.zip"
  if [ ! -f "$ZIP_FILE" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    curl -fL --retry 3 "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-all.zip" -o "$ZIP_FILE"
  fi
  unzip -q -o "$ZIP_FILE" -d "$(dirname "$GRADLE_HOME_DIR")"
fi
exec "$GRADLE_BIN" -p "$APP_HOME" "$@"
